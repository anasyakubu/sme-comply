# ---- Server ----
NODE_ENV=development
PORT=5000
APP_NAME=SME Comply
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
# Timezone used for due dates and the reminder scheduler
APP_TIMEZONE=Africa/Lagos

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/sme_comply
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/sme_comply?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sme_comply

# ---- JWT ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# ---- Gmail SMTP (Nodemailer) ----
# Leave SMTP_HOST empty in development to log automated emails instead of sending.
# Manual Super Admin sending requires real SMTP credentials and will fail closed
# when these are empty. Gmail requires a Google App Password (not your login password).
# Set SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=your-gmail-address, SMTP_PASSWORD=your-16-character-app-password.
# Set SMTP_FROM to a sender verified/authorized for your Gmail account.
# Port 587 uses required STARTTLS; never expose SMTP credentials to VITE_* vars.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SME Comply <no-reply@smecomply.ng>"

# ---- Cloudinary (leave empty to store uploads on local disk in ./uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sme-comply

# ---- Uploads ----
MAX_UPLOAD_MB=10

# ---- Scheduler ----
# Cron expression for the reminder job (default: every day at 07:00 Lagos time)
REMINDER_CRON=0 7 * * *
# Set to false to disable scheduled jobs (e.g. on a secondary instance)
ENABLE_JOBS=true
# How many months ahead compliance tasks are generated
TASK_HORIZON_MONTHS=12
